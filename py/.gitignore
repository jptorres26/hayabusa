# hayabusa-py: re-include everything the upstream root .gitignore's broad patterns
# (hayabusa*, test_*, *.txt, *.json, *.jsonl, *.csv, *.html) would otherwise drop.
!*
!**/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# runtime artefacts: the service's data directory and stray harness output
data/
hayabusa-timeline.jsonl
perf-report.json
